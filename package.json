{
  "name": "circles-app",
  "version": "0.1.0",
  "homepage": "https://leo0331.github.io/circles-app",
  "private": true,
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint src public/sw.js vite.config.mjs eslint.config.cjs",
    "check": "npm run lint && npm test -- --runInBand && npm run build",
    "test": "jest",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "vite": "^8.3.2"
  }
}
